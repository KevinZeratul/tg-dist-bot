# ===== tg-dist-bot 配置 =====
# 复制本文件为 .env 并填入真实值。

# Bot token，来自 @BotFather（创建机器人后获得）
BOT_TOKEN=123456789:AA...replace-me

# 私有频道的 ID：文件字节就存在这里。机器人必须是该频道的管理员。
# 频道 ID 是负数，例如 -1001234567890（可把频道里的一条消息转发给 @userinfobot 查看）。
CHANNEL_ID=-1001234567890

# 所有者（你）的 Telegram 用户 ID，来自 @userinfobot
OWNER_ID=123456789

# 额外的管理员 ID，空格分隔，可选
ADMINS=

# SQLite 数据库地址（默认即可，文件会生成在项目根目录）
DATABASE_URL=sqlite+aiosqlite:///tgdistbot.db
